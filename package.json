{
  "name": "multimodal_demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "bt eval --runner tsx src/evals/multimodal-chat.eval.ts",
    "eval:jsonl": "bt eval --runner tsx --jsonl src/evals/multimodal-chat.eval.ts",
    "eval:design": "bt eval --runner tsx src/evals/design-agent.eval.ts",
    "eval:design:jsonl": "bt eval --runner tsx --jsonl src/evals/design-agent.eval.ts",
    "images:generate": "node scripts/generate_eval_images.mjs",
    "images:generate:design": "python3 scripts/generate_design_images.py"
  },
  "dependencies": {
    "autoevals": "^0.0.132",
    "braintrust": "latest",
    "next": "^15.2.0",
    "openai": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
